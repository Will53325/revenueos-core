<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.caraway.scanner</string>
  <key>ProgramArguments</key>
  <array><string>/bin/bash</string><string>__PROJECT__/scripts/caraway-scan.sh</string></array>
  <key>WorkingDirectory</key><string>__PROJECT__</string>
  <!-- Every 4 hours. If the Mac was asleep, launchd runs it once on wake. -->
  <key>StartInterval</key><integer>14400</integer>
  <key>RunAtLoad</key><true/>
  <key>ProcessType</key><string>Background</string>
  <key>LowPriorityIO</key><true/>
  <key>Nice</key><integer>10</integer>
  <key>StandardOutPath</key><string>__PROJECT__/var/logs/launchd-scan.out</string>
  <key>StandardErrorPath</key><string>__PROJECT__/var/logs/launchd-scan.err</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key><string>/usr/local/bin:/opt/homebrew/bin:/usr/bin:/bin</string>
    <!-- To enable SAM.gov, uncomment and paste your free public API key:
    <key>CARAWAY_SAM_API_KEY</key><string>YOUR_KEY</string> -->
  </dict>
</dict>
</plist>
