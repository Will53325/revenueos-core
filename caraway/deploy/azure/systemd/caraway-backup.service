[Unit]
Description=Caraway database backup (online, verified, rotated; optional Azure Blob upload)

[Service]
Type=oneshot
User=caraway
Group=caraway
Slice=caraway.slice
WorkingDirectory=@APP_DIR@
EnvironmentFile=@SECRETS_DIR@/caraway.env
Environment=CARAWAY_HOME=@DATA_DIR@ CARAWAY_SECRETS_DIR=@SECRETS_DIR@ PYTHONUNBUFFERED=1
ExecStart=/usr/bin/python3 -m caraway backup
Nice=15
IOSchedulingClass=idle
ReadWritePaths=@DATA_DIR@
ReadOnlyPaths=@SECRETS_DIR@ @APP_DIR@
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictSUIDSGID=yes
RestrictNamespaces=yes
RestrictRealtime=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
CapabilityBoundingSet=
SystemCallArchitectures=native
UMask=0077
